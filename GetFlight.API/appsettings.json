{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyForDevPurposesOnlyDontUseInProduction",
    "Issuer": "GetFlightApi",
    "Audience": "GetFlightClient",
    "ExpireMinutes": 60
  },
  "AllowedHosts": "*"
}
